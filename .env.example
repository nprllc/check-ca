# Toutes les clés sont optionnelles sauf pour de vraies analyses.
# Copier en .env, renseigner, puis :  set -a; . ./.env; set +a

# Vérification des affirmations — Mistral Conversations API + web_search (défaut)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest
# Repli possible : Claude API (Anthropic), utilisé si MISTRAL_API_KEY est absente
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Fact-checks déjà publiés (Google Fact Check Tools)
GOOGLE_FACTCHECK_API_KEY=

# Recherche inversée des images (SerpApi, payant) : origine des images
SERPAPI_API_KEY=

# Détecteur IA (endpoint compatible, renvoie [{label, score}…])
AI_DETECTOR_URL=
AI_DETECTOR_TOKEN=

# Limites et stockage
RATE_LIMIT_PER_HOUR=20
MAX_ANALYSES_PER_DAY=200
CHECKCA_DB=checkca.sqlite3
